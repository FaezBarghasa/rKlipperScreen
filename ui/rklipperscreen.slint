import { Button, ScrollView, StandardListView, GridBox } from "std-widgets.slint";
import { Theme } from "./themes/material_dark.slint";
import { L10n, TemperaturePanel } from "./panels/temperature.slint";
import { MovePanel } from "./panels/move.slint";
import { FilesPanel } from "./panels/files.slint";
import { ConsolePanel } from "./panels/console.slint";

export { L10n }

import { MenuItemInfo, GCodeFileInfo, ConsoleLine } from "./types.slint";
export { MenuItemInfo, GCodeFileInfo, ConsoleLine }

component IconButton inherits Rectangle {
    in-out property <image> icon;
    in-out property <string> text;
    in-out property <bool> active: false;
    callback clicked;

    min-width: 48px;
    min-height: 48px;

    background: self.active ? Theme.active : (touch.pressed ? Theme.active : Theme.button-bg);
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.accent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        alignment: center;

        Image {
            source: root.icon;
            width: 48px;
            height: 48px;
            image-fit: contain;
        }
        if root.text != "" : Text {
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }
}

export component MainApp inherits Window {
    title: "rKlipperScreen";
    background: Theme.bg;
    width: 800px;
    height: 480px;

    // Configuration and states updated by Rust
    in-out property <string> printer-state: "disconnected";
    in-out property <float> extruder-temp: 0.0;
    in-out property <float> extruder-target: 0.0;
    in-out property <float> bed-temp: 0.0;
    in-out property <float> bed-target: 0.0;
    in-out property <float> fan-speed: 0.0;
    in-out property <float> print-progress: 0.0;
    in-out property <string> print-filename: "";
    in-out property <string> current-panel: "main_menu";
    in-out property <string> menu-title: "Main Menu";

    // Models for lists
    in-out property <[MenuItemInfo]> menu-items;
    in-out property <[GCodeFileInfo]> gcode-files;
    in-out property <[ConsoleLine]> console-lines;

    // Active icons for navigation
    in-out property <image> icon-home;
    in-out property <image> icon-back;
    in-out property <image> icon-settings;
    in-out property <image> icon-estop;

    // Internal UI selection states
    property <string> active-temp-device: "";
    property <string> temp-input-buffer: "";
    property <float> jog-increment: 10.0;

    // Callbacks to Rust
    callback menu-item-clicked(int);
    callback menu-go-back;
    callback menu-go-home;
    callback set-temperature(string, float);
    callback jog-move(string, float);
    callback home-axis(string);
    callback file-action(string, string);
    callback send-gcode(string);
    callback estop-clicked;

    // Layout
    HorizontalLayout {
        // Sidebar Toolbar
        VerticalLayout {
            width: 70px;
            padding: 4px;
            spacing: 8px;
            alignment: space-between;

            VerticalLayout {
                spacing: 8px;
                IconButton {
                    icon: root.icon-home;
                    text: "";
                    clicked => { root.menu-go-home(); }
                }
                IconButton {
                    icon: root.icon-back;
                    text: "";
                    clicked => { root.menu-go-back(); }
                }
            }

            IconButton {
                icon: root.icon-estop;
                text: "";
                background: Theme.error;
                clicked => { root.estop-clicked(); }
            }
        }

        // Main Area
        VerticalLayout {
            // Header
            Rectangle {
                height: 45px;
                background: Theme.panel-bg;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.accent;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.menu-title;
                            color: Theme.text;
                            font-weight: 700;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "[" + root.printer-state + "]";
                            color: root.printer-state == "printing" ? Theme.accent : Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        // Extruder Setpoint Info
                        HorizontalLayout {
                            spacing: 4px;
                            Text { text: "Ex:"; color: Theme.text; font-size: 14px; vertical-alignment: center; }
                            Text {
                                text: Math.round(root.extruder-temp) + "° / " + Math.round(root.extruder-target) + "°";
                                color: Theme.accent;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        // Bed Setpoint Info
                        HorizontalLayout {
                            spacing: 4px;
                            Text { text: "Bed:"; color: Theme.text; font-size: 14px; vertical-alignment: center; }
                            Text {
                                text: Math.round(root.bed-temp) + "° / " + Math.round(root.bed-target) + "°";
                                color: Theme.accent;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        if root.printer-state == "printing" : HorizontalLayout {
                            spacing: 4px;
                            Text { text: "Progress:"; color: Theme.text; font-size: 14px; vertical-alignment: center; }
                            Text {
                                text: Math.round(root.print-progress) + "%";
                                color: Theme.accent;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Panel Switcher
            Rectangle {
                background: Theme.bg;

                if root.current-panel == "main_menu" : ScrollView {
                    GridLayout {
                        padding: 8px;
                        spacing: 12px;
                        // Render flat dynamic menu
                        for item[idx] in root.menu-items : Row {
                            IconButton {
                                icon: item.icon;
                                text: L10n.translate(item.name);
                                clicked => { root.menu-item-clicked(idx); }
                            }
                        }
                    }
                }

                if root.current-panel == "temperature" : TemperaturePanel {
                    extruder-temp: root.extruder-temp;
                    extruder-target: root.extruder-target;
                    bed-temp: root.bed-temp;
                    bed-target: root.bed-target;
                    active-temp-device: root.active-temp-device;
                    temp-input-buffer: root.temp-input-buffer;
                    set-temperature(device, val) => { root.set-temperature(device, val); }
                }

                if root.current-panel == "move" : MovePanel {
                    jog-increment: root.jog-increment;
                    jog-move(axis, val) => { root.jog-move(axis, val); }
                    home-axis(axis) => { root.home-axis(axis); }
                }

                if root.current-panel == "gcodes" : FilesPanel {
                    gcode-files: root.gcode-files;
                    file-action(action, file) => { root.file-action(action, file); }
                }

                if root.current-panel == "console" : ConsolePanel {
                    console-lines: root.console-lines;
                    temp-input-buffer: root.temp-input-buffer;
                    send-gcode(cmd) => { root.send-gcode(cmd); }
                    estop-clicked => { root.estop-clicked(); }
                }
            }
        }
    }
}
