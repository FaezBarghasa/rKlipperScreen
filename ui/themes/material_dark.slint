export global Theme {
    in-out property <color> bg: #121212;            // Material dark background
    in-out property <color> active: #1F3A52;        // Cool blue active highlight
    in-out property <color> accent: #00ADB5;        // Teal accent color
    in-out property <color> text: #EEEEEE;          // Light grey text
    in-out property <color> error: #CF6679;         // Soft red error state
    in-out property <color> warning: #FFB74D;       // Soft orange warning state
    in-out property <color> echo: #4DB6AC;          // Soft green console echo
    in-out property <color> panel-bg: #1E1E1E;      // Panel background
    in-out property <color> button-bg: #2D2D2D;     // Button background
}
