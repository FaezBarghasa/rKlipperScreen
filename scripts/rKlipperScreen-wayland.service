[Unit]
Description=rKlipperScreen Wayland Kiosk Session
After=rusted_moonraker.service systemd-udevd.service
Wants=rusted_moonraker.service

[Service]
User=klipper
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/cage -s -m last -- /usr/local/bin/rklipperscreen
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
